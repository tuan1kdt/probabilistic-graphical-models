{
 "data": {
  "uci_id": 603,
  "name": "In-Vehicle Coupon Recommendation",
  "raw_file": "data/raw/coupon/in-vehicle-coupon-recommendation.csv",
  "processed_file": "data/processed/coupon_discretized.csv",
  "group_col": "resp_id",
  "treatment": "T",
  "treatment_coding": {
   "1d": 0,
   "2h": 1
  },
  "outcome": "Y",
  "excluded": [
   "Bar × Work",
   "rows with missing habit_match"
  ]
 },
 "seeds": [
  0,
  1,
  2,
  3,
  4
 ],
 "split": {
  "train": 0.7,
  "val": 0.15,
  "test": 0.15,
  "group": "resp_id",
  "stratify_on": "respondent y_rate tertile"
 },
 "tiers": {
  "respondent": [
   "habit_match",
   "age_bin",
   "income_bin",
   "gender",
   "has_children"
  ],
  "scenario": [
   "coupon",
   "destination",
   "time_bin",
   "passenger",
   "weather",
   "dist",
   "direction_same"
  ],
  "treatment": [
   "T"
  ],
  "outcome": [
   "Y"
  ]
 },
 "nodes": [
  "habit_match",
  "age_bin",
  "income_bin",
  "gender",
  "has_children",
  "coupon",
  "destination",
  "time_bin",
  "passenger",
  "weather",
  "dist",
  "direction_same",
  "T",
  "Y"
 ],
 "C_core": [
  "coupon",
  "destination"
 ],
 "C_ext": [
  "coupon",
  "destination",
  "time_bin",
  "weather"
 ],
 "C_full": [
  "coupon",
  "destination",
  "time_bin",
  "weather",
  "passenger",
  "dist",
  "direction_same",
  "habit_match",
  "age_bin",
  "income_bin",
  "gender",
  "has_children"
 ],
 "forbidden_edges_rules": [
  "no edge out of Y",
  "no edge from respondent tier into T",
  "no edge from T into tier 1–2"
 ],
 "required_edges": [
  [
   "T",
   "Y"
  ],
  [
   "coupon",
   "Y"
  ],
  [
   "habit_match",
   "Y"
  ]
 ],
 "cpd": {
  "estimator": "BayesianEstimator",
  "prior_type": "BDeu",
  "equivalent_sample_size": 5
 },
 "b0": {
  "algorithm": "HillClimbSearch",
  "scoring": "bic-d",
  "max_indegree": 3
 },
 "h1": {
  "replace_node": "Y",
  "hidden": [
   32,
   16
  ],
  "dropout": 0.2,
  "lr": 0.001,
  "batch_size": 256,
  "max_epochs": 200,
  "patience": 10,
  "loss": "bce"
 },
 "h2": {
  "method": "notears-nonlinear",
  "lambda1": 0.01,
  "lambda2": 0.01,
  "edge_threshold": 0.3,
  "cycle_repair": "drop-weakest-edge"
 },
 "refute": {
  "placebo": {
   "placebo_type": "permute",
   "num_simulations": 100
  },
  "subset": {
   "subset_fraction": 0.8,
   "num_simulations": 100
  }
 },
 "uncertainty": {
  "method": "bootstrap-train-by-resp_id-fixed-test",
  "n_boot": 200,
  "level": 0.95
 }
}