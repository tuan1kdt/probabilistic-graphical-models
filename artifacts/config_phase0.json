{
  "CONFIG": {
    "project": {
      "course": "IT701100",
      "term": "HK1 2026-2027",
      "student": "Le Anh Tuan"
    },
    "seeds": [
      0,
      1,
      2,
      3,
      4
    ],
    "split": {
      "train": 0.7,
      "val": 0.15,
      "test": 0.15,
      "stratify_on": "y"
    },
    "data": {
      "uci_id": 222,
      "name": "Bank Marketing",
      "file": "bank-additional-full.csv",
      "raw_dir": "data/raw",
      "processed_dir": "data/processed",
      "treatment": "contact",
      "treatment_coding": {
        "telephone": 0,
        "cellular": 1
      },
      "outcome": "y",
      "outcome_coding": {
        "no": 0,
        "yes": 1
      },
      "drop_post_treatment": [
        "duration"
      ]
    },
    "cpd": {
      "estimator": "BayesianEstimator",
      "prior_type": "BDeu",
      "equivalent_sample_size": 5
    },
    "b0": {
      "algorithm": "HillClimbSearch",
      "scoring": "bic-d",
      "max_indegree": 3
    },
    "h1": {
      "replace_node": "y",
      "hidden": [
        16
      ],
      "dropout": 0.2,
      "lr": 0.001,
      "batch_size": 256,
      "max_epochs": 200,
      "patience": 10,
      "loss": "bce"
    },
    "h2": {
      "method": "notears-nonlinear",
      "lambda1": 0.01,
      "lambda2": 0.01,
      "edge_threshold": 0.3,
      "cycle_repair": "drop-weakest-edge"
    },
    "refute": {
      "placebo": {
        "placebo_type": "permute",
        "num_simulations": 100
      },
      "subset": {
        "subset_fraction": 0.8,
        "num_simulations": 100
      }
    },
    "uncertainty": {
      "method": "bootstrap-train-fixed-test",
      "n_boot": 200,
      "level": 0.95
    },
    "node_order": null,
    "state_names": null,
    "forbidden_edges": null,
    "baseline_covariates": null
  },
  "ENV": {
    "python": "3.13.18",
    "platform": "Linux-6.18.44-fc-v185-x86_64-with-glibc2.39",
    "machine": "x86_64",
    "cpu_count": 2,
    "cuda": false,
    "numpy": "2.5.3",
    "pandas": "3.0.5",
    "networkx": "3.7",
    "pgmpy": "1.1.2",
    "dowhy": "0.14",
    "torch": "2.15.0+cu132",
    "sklearn": "1.9.1"
  }
}